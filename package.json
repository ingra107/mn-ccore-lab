{
  "name": "mn-ccore-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "node -e \"const{execSync}=require('child_process');const steps=['eslint .','npm run lint:select-star','npm run lint:color-concat','npm run lint:no-optional-request','npm run lint:token-snap'];let failed=false;for(const s of steps){try{execSync(s,{stdio:'inherit'})}catch{failed=true;console.error('[lint] FAILED: '+s)}}process.exit(failed?1:0)\"",
    "lint:opacity": "node scripts/check-opacity-floor.mjs",
    "lint:select-star": "node scripts/check-select-star.mjs --enforce",
    "lint:color-concat": "node scripts/check-color-string-concat.mjs --enforce",
    "lint:no-optional-request": "node scripts/check-no-optional-request.mjs",
    "lint:token-snap": "node scripts/check-token-snap.mjs",
    "preview": "vite preview",
    "seed": "tsx scripts/seed-d1.ts",
    "db:schema": "bash scripts/wrangler-d1 d1 execute mnccore-lab --file=api/bootstrap-schema.sql",
    "db:seed": "bash scripts/wrangler-d1 d1 execute mnccore-lab --file=scripts/seed.sql",
    "db:schema:remote": "bash scripts/wrangler-d1 d1 execute mnccore-lab --file=api/bootstrap-schema.sql --remote",
    "db:seed:remote": "bash scripts/wrangler-d1 d1 execute mnccore-lab --file=scripts/seed.sql --remote",
    "test": "npm run test:local",
    "test:api": "vitest run --config vitest.config.api.ts",
    "test:lib": "vitest run --config vitest.config.lib.ts",
    "test:src": "vitest run --config vitest.config.ts",
    "test:vitest": "npm run test:api && npm run test:lib && npm run test:src",
    "audit:schema-contract": "tsx scripts/audit-schema-contract.ts",
    "audit:writer-shapes": "python scripts/writer-shape-check.py",
    "test:local": "concurrently -k -s first \"wrangler dev api/index.ts --local --config=wrangler.local.toml --port 8787\" \"wait-on http-get://localhost:8787/api/projects && playwright test --config=playwright.config.local.ts\"",
    "test:journeys": "concurrently -k -s first \"wrangler dev api/index.ts --local --config=wrangler.local.toml --port 8787\" \"vite --port 5173\" \"wait-on http-get://localhost:5173 && playwright test --config=playwright.config.journeys.ts\"",
    "test:journeys:one": "node scripts/run-journey-spec.mjs",
    "test:local:setup": "tsx scripts/local-db-bootstrap.ts && tsx scripts/local-db-seed.ts",
    "test:prod": "playwright test --config=playwright.config.prod.ts",
    "test:smoke": "npx playwright test tests/smoke.spec.ts --config=playwright.config.prod.ts",
    "test:meeting-approval": "npx playwright test --config=playwright.config.meeting-approval.ts",
    "test:headed": "npx playwright test --headed",
    "preflight": "tsx scripts/pre-flight/00-orchestrator.ts",
    "preflight:pi": "tsx scripts/pre-flight/persona-pi-power-user.ts",
    "preflight:collaborator": "tsx scripts/pre-flight/persona-collaborator.ts",
    "preflight:coordinator": "tsx scripts/pre-flight/persona-coordinator.ts",
    "preflight:trainee": "tsx scripts/pre-flight/persona-trainee.ts",
    "preflight:mobile": "tsx scripts/pre-flight/persona-mobile.ts",
    "preflight:a11y": "tsx scripts/pre-flight/persona-accessibility.ts",
    "preflight:breaker": "tsx scripts/pre-flight/persona-breaker.ts",
    "predeploy:identity": "python scripts/check-project-identity-gate.py",
    "postdeploy:probe": "node scripts/post-deploy-probe.mjs",
    "deploy:pages:gated": "npm run predeploy:identity && npm run build && wrangler pages deploy dist --project-name mn-ccore-lab --branch main && npm run postdeploy:probe",
    "deploy:worker": "python scripts/wrangler_d1.py deploy --env production"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@formkit/auto-animate": "^0.9.0",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-virtual": "^3.13.23",
    "@tiptap/extension-link": "^3.22.3",
    "@tiptap/extension-placeholder": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "@types/react-grid-layout": "^1.3.6",
    "aws4fetch": "^1.0.20",
    "hono": "^4.12.14",
    "partysocket": "^1.1.16",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-grid-layout": "^1.5.3",
    "reagraph": "^4.30.8",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@cloudflare/vitest-pool-workers": "^0.14.7",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.4",
    "@vitest/browser-playwright": "^4.1.4",
    "better-sqlite3": "^12.8.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "framer-motion": "^12.38.0",
    "globals": "^17.4.0",
    "lucide-react": "^1.0.1",
    "miniflare": "^4.20260415.0",
    "react-router-dom": "^7.13.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.4",
    "wait-on": "^9.0.5",
    "wrangler": "^4.14.0"
  }
}
