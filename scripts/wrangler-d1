#!/usr/bin/env bash
# scripts/wrangler-d1 — THE sanctioned wrangler entry point for this repo.
#
# WHY THIS EXISTS
# ---------------
# The Pages-deploy token LACKS D1 scope. When it sits in the env as
# CLOUDFLARE_API_TOKEN (or the legacy CF_API_TOKEN), wrangler PREFERS it over
# the OAuth credentials at ~/.wrangler/config/default.toml (which DO have
# `d1 (write)` scope), and any `wrangler d1` call fails 401 / 403 / 7403 /
# "Authentication error code 10000" — misdiagnosed as "can't reach D1" eight
# times. secrets.ps1 exported it under that name until 2026-08-02; it now
# exports PB_CLOUDFLARE_PAGES_API_TOKEN (PB #884), but any shell can still
# carry the reserved name.
#
# This wrapper makes the fix structural instead of remembered: it ALWAYS strips
# the two env vars before invoking wrangler, so the OAuth path is always used.
#
# USAGE
#   scripts/wrangler-d1 d1 execute mnccore-lab --remote --command "SELECT 1"
#   scripts/wrangler-d1 d1 execute mnccore-lab --remote --json --command "..."
#   scripts/wrangler-d1 whoami
#
# Any wrangler subcommand works; this is a thin pass-through with the env strip.
# Run from the repo root (npx resolves the repo-local wrangler@^4 devDependency).
#
# Memory rule cross-reference:
#   ~/.claude/.../memory/feedback_wrangler-home-auth-works.md
# Team-guide cross-reference: CLAUDE.md "Wrangler / D1 auth" section.
#
# DO NOT call `npx wrangler d1 ...` raw anywhere in this repo. The pre-commit
# lint (.githooks/pre-commit) flags raw `wrangler d1` calls outside this
# wrapper and .github/workflows/ (CI uses a proper D1-scoped secret).

set -euo pipefail

# Resolve to the repo root regardless of cwd, so npx finds the repo-local
# wrangler and a caller from any directory behaves identically.
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# THE STRIP. Unconditional — env may or may not be set; either way, after this
# wrangler uses OAuth. `unset` is a no-op when the var is absent.
unset CLOUDFLARE_API_TOKEN
unset CLOUDFLARE_ACCOUNT_ID
# The legacy names shadow OAuth the same way (2026-10-19: a shell carrying one
# got "Authentication error 10000" through this wrapper; env -u of these fixed it).
unset CF_API_TOKEN CF_API_KEY CF_ACCOUNT_ID CLOUDFLARE_API_KEY

exec npx wrangler "$@"
