#!/usr/bin/env bash
# Git pre-commit hook for mn-ccore-lab.
#
# Activate with:
#   git config core.hooksPath .githooks
#
# What this hook does:
#
# 1. (CX-E2, 2026-04-28 Codex holistic review): invoke PB's
#    `check_sync_antipatterns.py` if PB checkout is adjacent. Catches the
#    same SQL anti-pattern shapes (R1-R5) + identity-write rules (R6-R9)
#    on Hub commits that would otherwise only be enforced on PB pre-commit.
#    Bypasses cleanly if PB isn't checked out (e.g., Hub-only contributor).
#
# Removed (CX-S2, 2026-04-28): the original Airtable cascade enforcement
# that required handleDeleteProject to call cascadeAirtableProjectDelete.
# Airtable was retired 2026-04-21 and CX-S2 deleted the cascade entirely
# (commit e6fc63e5). Re-introducing the check would block every future
# commit to projects.ts.

set -e

# ---------------------------------------------------------------------------
# WORKPLAN.html regeneration (2026-05-24). Option B: WORKPLAN.md is the
# editable source of truth; WORKPLAN.html is GENERATED, never hand-edited.
# When WORKPLAN.md is staged, regenerate the HTML and re-stage it so the two
# can never drift. Cheap: only fires when WORKPLAN.md is in the staged set.
if git diff --cached --name-only --diff-filter=AM | grep -qx "WORKPLAN.md"; then
    if command -v python >/dev/null 2>&1; then
        if python "$(dirname "$0")/../scripts/gen_workplan_html.py" >/dev/null 2>&1; then
            git add -- WORKPLAN.html
            echo "[hub-precommit] Regenerated + staged WORKPLAN.html from WORKPLAN.md."
        else
            echo "[hub-precommit] WARN: gen_workplan_html.py failed; committing WORKPLAN.md without HTML regen."
        fi
    else
        echo "[hub-precommit] WARN: python not found; skipping WORKPLAN.html regen."
    fi
fi

# ---------------------------------------------------------------------------
# Wrangler-D1 entry-point lint (2026-05-24). Flags RAW `wrangler d1` /
# `npx wrangler d1 execute` in staged files (wrangler-d1-allowed: rule doc).
# ALL programmatic D1 calls must go
# through the sanctioned env-stripping entry point (scripts/wrangler-d1 shell
# shim or scripts/wrangler_d1.py), which unsets CLOUDFLARE_API_TOKEN /
# CLOUDFLARE_ACCOUNT_ID before invoking wrangler — the fix for the recurring
# OAuth-shadow auth failure (feedback_wrangler-home-auth-works.md).
#
# Exemptions (legitimate raw callers):
#   - .github/workflows/   CI uses a proper D1-scoped secret, not OAuth.
#   - scripts/wrangler-d1, scripts/wrangler_d1.py  the wrapper itself.
#   - *.md doc/comment usage may carry an allow marker `wrangler-d1-allowed`.
# A line carrying `wrangler-d1-allowed` anywhere on it is allowed (escape hatch
# for docs/comments that must show the raw form).
raw_d1_hits=""
for f in $(git diff --cached --name-only --diff-filter=AM); do
    case "$f" in
        .github/workflows/*) continue ;;
        scripts/wrangler-d1|scripts/wrangler_d1.py) continue ;;
    esac
    # Only inspect text files that still exist in the working tree.
    [ -f "$f" ] || continue
    # Match `wrangler d1` or `npx wrangler d1` not preceded by the wrapper name.
    # Skip lines carrying the allow marker.
    while IFS= read -r line; do
        case "$line" in *wrangler-d1-allowed*) continue ;; esac
        raw_d1_hits="${raw_d1_hits}${f}: ${line}
"
    done < <(grep -nE '(npx )?wrangler d1 (execute|export)' "$f" 2>/dev/null | grep -vE 'wrangler-d1|wrangler_d1' || true)
done
if [ -n "$raw_d1_hits" ]; then
    echo ""
    echo "BLOCKED: raw 'wrangler d1' call(s) found — route through the sanctioned"
    echo "entry point (scripts/wrangler-d1 shell shim OR scripts/wrangler_d1.py)."
    echo "These strip CLOUDFLARE_API_TOKEN/ACCOUNT_ID so OAuth (which has D1 scope)"
    echo "is used. See CLAUDE.md 'Wrangler / D1 auth' + feedback_wrangler-home-auth-works.md."
    echo ""
    printf '%s' "$raw_d1_hits"
    echo ""
    echo "If a raw form is genuinely required (CI, docs), add 'wrangler-d1-allowed'"
    echo "on the line, or place it under .github/workflows/."
    exit 1
fi

# Resolve PB checkout path (sibling to mn-ccore-lab on Nick's two laptops).
PB_ROOT=""
for cand in "$(cd "$(dirname "$0")/.." && pwd)/../Peripheral-Brain" \
            "$HOME/Peripheral-Brain" \
            "/c/Users/ingra/Peripheral-Brain" \
            "/c/Users/ingra107/Peripheral-Brain"; do
    if [ -f "$cand/scripts/db/check_sync_antipatterns.py" ]; then
        PB_ROOT="$cand"
        break
    fi
done

# Only run the lint when api/ TS or schema-v*.sql files are staged. Cheap
# check — the lint itself is fast (<1s on full Hub checkout) but the staged-
# file guard saves a fork+exec on doc-only commits.
if git diff --cached --name-only --diff-filter=AM \
        | grep -qE "^api/(routes|middleware|lib)/.*\.(ts|tsx)$|^api/schema-v.*\.sql$"; then
    if [ -z "$PB_ROOT" ]; then
        echo "[hub-precommit] WARN: PB checkout not adjacent; skipping sync-antipattern lint."
        echo "[hub-precommit] To enforce: clone Peripheral-Brain at \$HOME/Peripheral-Brain or sibling to mn-ccore-lab."
    else
        # Run from PB root so the checker's relative paths + sibling-mn-ccore-lab
        # detection work as designed (the checker walks ../mn-ccore-lab when
        # invoked from PB root). This catches Hub-side R1-R9 violations even
        # when the commit is purely in the Hub repo.
        if ! ( cd "$PB_ROOT" && python scripts/db/check_sync_antipatterns.py ); then
            echo ""
            echo "BLOCKED: Hub commit triggered sync-antipattern lint failure."
            echo ""
            echo "The checker enforces R1-R9 — see"
            echo "  $PB_ROOT/scripts/db/check_sync_antipatterns.py"
            echo "  $PB_ROOT/Context/Topics/codex-failure-rate-mechanisms-2026-04-28.md"
            echo ""
            echo "Either fix the pattern, or add an allowlist marker"
            echo "(\`// anti-pattern-allowed: <reason>\`) within 10 lines above the hit."
            exit 1
        fi
    fi
fi

# ---------------------------------------------------------------------------
# Color-string-concat gate (2026-06-16, backlog #44). Blocks commits that
# introduce new hardcoded rgba task-accent literals. Only runs the lint
# script — not the full build — to keep pre-commit fast.
if ! node scripts/check-color-string-concat.mjs --enforce; then
    echo ""
    echo "BLOCKED: new hardcoded rgba task-accent literal(s) found."
    echo "Use withAlpha(TOKEN, pct) from src/lib/taskGrouping.ts instead."
    echo ""
    echo "NOTE — two opposite rules depending on context:"
    echo "  inline-style rgba() literal  → replace with withAlpha(TOKEN, pct)"
    echo "  static Tailwind -[rgba(...)]  → LEAVE as a static literal (never template it)"
    echo ""
    exit 1
fi

# ---------------------------------------------------------------------------
# Tailwind arbitrary-value runtime-interpolation gate (2026-06-17, backlog #94).
# Tailwind JIT emits CSS only for COMPLETE LITERAL arbitrary values seen at
# build time.  Templating a runtime expression inside a Tailwind arbitrary
# value slot — e.g.  className={`hover:!bg-[${ withAlpha(X,10) }]`} — produces
# valid JS that silently emits NO CSS at build time.
#
# Pattern flagged:  -[${  appearing in className= / class: contexts inside
# staged .tsx/.ts/.css files.
#
# CORRECT FIXES (depends on what you're building):
#   A) The value must vary at runtime → use an inline style, NOT a Tailwind class:
#        style={{ background: withAlpha(PANEL_BG, 10) }}
#   B) The value is always the same literal → write it as a static Tailwind class:
#        className="hover:!bg-[rgba(15,25,35,0.10)]"   ← grandfathered static = OK
#
# NEVER template a dynamic expression inside a Tailwind arbitrary-value slot.
tw_interp_hits=""
for f in $(git diff --cached --name-only --diff-filter=AM); do
    [ -f "$f" ] || continue
    case "$f" in *.ts|*.tsx|*.css) ;; *) continue ;; esac
    while IFS= read -r line; do
        tw_interp_hits="${tw_interp_hits}${f}: ${line}
"
    done < <(grep -nE '\-\[\$\{' "$f" 2>/dev/null || true)
done
if [ -n "$tw_interp_hits" ]; then
    echo ""
    echo "BLOCKED: Tailwind arbitrary-value slot contains a runtime interpolation."
    echo "Tailwind JIT only emits CSS for COMPLETE LITERALS — \`-[\${expr}]\` produces"
    echo "valid JS that silently generates NO CSS at build time."
    echo ""
    printf '%s' "$tw_interp_hits"
    echo ""
    echo "CORRECT FIXES:"
    echo "  Runtime value  → use inline style:  style={{ background: withAlpha(TOKEN, pct) }}"
    echo "  Static value   → write the full literal:  className=\"...-[rgba(15,25,35,0.10)]\""
    echo ""
    echo "The static Tailwind arbitrary form (-[rgba(...)]) is grandfathered and fine."
    echo "The dynamic inline-style form (withAlpha in style={{}}) is also fine."
    echo "The ONLY forbidden form is -[\${runtime}] inside a className/class value."
    exit 1
fi

# ---------------------------------------------------------------------------
# Cookieless-artifact-origin minimality gate (2026-07-29, PB backlog #883).
# The #508 origin split's security property holds ONLY while artifacts-site/
# stays authority-free (one Function route, one code-owned D1 read binding,
# nothing else). Before this gate that constraint was prose-only and NO
# pre-commit gate fired on artifacts-site/** at all. Allowlist check — an
# unknown new binding/section/route fails closed. Deploy-time twin lives in
# package.json deploy:artifacts.
if git diff --cached --name-only --diff-filter=ACMR \
        | grep -qE "^artifacts-site/|^scripts/check-artifacts-origin-minimal\.mjs$"; then
    if ! node scripts/check-artifacts-origin-minimal.mjs; then
        echo ""
        echo "BLOCKED: artifacts-site/ change breaks the cookieless origin's minimality"
        echo "(the whole value of #508 — see artifacts-site/wrangler.toml header)."
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Ledger-registry gate (2026-06-18, bounded-ledger primitive).
# Rejects any new schema-v*.sql that introduces a CREATE TABLE with a
# timestamp column that lacks a LEDGER_REGISTRY entry in
# api/lib/ledger-retention.ts. This makes "a ledger with no retention"
# unrepresentable at commit time (Level-1, post-mortem fix for the
# 2026-06-18 processed_mutations 88k-row D1 bloat incident).
# Only runs when a schema-v*.sql file is staged — zero friction otherwise.
if git diff --cached --name-only --diff-filter=AM \
        | grep -qE "^api/schema-v.*\.sql$"; then
    if command -v python >/dev/null 2>&1; then
        if ! python scripts/check-ledger-registry.py --staged-only; then
            echo ""
            echo "Add a LEDGER_REGISTRY entry in api/lib/ledger-retention.ts, then re-commit."
            exit 1
        fi
    else
        echo "[hub-precommit] WARN: python not found; skipping ledger-registry gate."
    fi
fi

# ---------------------------------------------------------------------------
# Schema-version snapshot gate (2026-06-18, backlog CI fix). The INFRA-5
# integrity check (scripts/check-schema-versions.py) previously ran ONLY in
# the scheduled `D1 Schema Drift Check` workflow — so adding an
# api/schema-v*.sql file without regenerating scripts/schema-version-snapshot.json
# failed SILENTLY for days (caught only by a daily CI email). v81/v82 went
# 5 days RED on main this way. Run the check at commit, but ONLY when a schema
# file is staged (the exact condition that bites) — zero friction on normal
# commits. Closes the class: a stale snapshot can no longer reach main.
if git diff --cached --name-only --diff-filter=AM \
        | grep -qE "^api/schema-v.*\.sql$"; then
    if command -v python >/dev/null 2>&1; then
        if ! python scripts/check-schema-versions.py; then
            echo ""
            echo "BLOCKED: api/schema-v*.sql staged but scripts/schema-version-snapshot.json"
            echo "is stale. Run:"
            echo "  python scripts/check-schema-versions.py --update"
            echo "then stage the updated snapshot alongside your schema file(s)."
            exit 1
        fi
    else
        echo "[hub-precommit] WARN: python not found; skipping schema-version snapshot check."
    fi
fi

# ---------------------------------------------------------------------------
# Worker type-check gate (backlog #966, 2026-07-30). `check-api-types.mjs`
# (backlog #501b-class check, authored 2026-07-22 for the #98 incident: a
# `{ slug } | { error }` union access shipped as a plain TS2339 and 500'd on
# every request in prod) was wired ONLY into `deploy:pages:gated` -- so a
# broken api/ type could sit on main through any number of commits, caught
# only the next time someone runs a manual deploy. Neither pre-commit nor CI
# (.github/workflows/vitest.yml runs test:api/lib/src, never typecheck:api)
# ran it before now. Scoped to api/, shared/, and the check's own config so
# doc/frontend-only commits pay nothing; ~8-9s on a full api/ typecheck when
# it does fire.
#
# The baseline is NOT zero, and an earlier version of this comment said it was.
# `scripts/api-types-baseline.json` holds 39 signatures summing to 149 errors,
# and the gate reports `PASS - 0 new errors (149 known, unchanged)`. The api/
# tree does NOT typecheck clean. The "149 -> 0" reading came from the bug the
# same commit fixed: check-api-types.mjs passed silently when tsc could not
# build, so a failed build produced zero errors and the script read that as
# "debt dropped to 0". With the silent pass fixed, the real floor is visible.
# So this is a RATCHET on a 149-error floor, not a clean gate: it blocks NEW
# errors only. Paying the floor down is separate work; `npm run
# typecheck:api:update` lowers it once errors are actually fixed.
if git diff --cached --name-only --diff-filter=ACMR \
        | grep -qE "^api/.*\.tsx?$|^shared/.*\.tsx?$|^tsconfig\.api\.json$|^scripts/check-api-types\.mjs$"; then
    echo "[hub-precommit] api/ staged -- running worker type-check gate..."
    if ! npm run --silent typecheck:api; then
        echo ""
        echo "BLOCKED: new worker type error(s) in api/ (see above)."
        echo "Fix the error, or if the baseline genuinely needs to move, run"
        echo "  npm run typecheck:api:update"
        echo "and stage scripts/api-types-baseline.json alongside your change."
        echo "The floor may only go down or stay flat -- it refuses to rise."
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Vitest gate (backlog #505, 2026-07-16). Before this, NOTHING in the repo
# ran any vitest suite as a commit/CI gate — `npm run test:api` (1129+ tests)
# only ran manually, and the two configs covering src/ (vitest.config.lib.ts,
# node-mode pure-logic; vitest.config.ts, browser-mode component tests) had
# no npm script at all, so a src/ logic test (e.g. #499's seen-tracking
# tests) had to be run ad-hoc via `npx tsx`, outside any gate. #546 is the
# concrete cost of an untested seam shipping through a green-but-never-run
# suite. Scoped to fire only when api/, src/, a vitest config, or
# package.json is staged — keeps doc-only / Scratch-only commits fast. All
# three suites combined run in ~5-10s on a full checkout.
if git diff --cached --name-only --diff-filter=ACMR \
        | grep -qE "^api/.*\.tsx?$|^src/.*\.tsx?$|^vitest\.config.*\.ts$|^package\.json$"; then
    echo "[hub-precommit] api/ or src/ staged -- running vitest gate (api + lib + src)..."
    if ! npm run --silent test:vitest; then
        echo ""
        echo "BLOCKED: vitest suite failed (api/lib/src). Fix the code or the test"
        echo "before committing -- see CLAUDE.md 'Testing' section for the three configs."
        exit 1
    fi
    # eslint zero-error ratchet (backlog #174 burn-down, 2026-07-16): src/ reached
    # 0 errors via a 4-agent wave; this gate keeps it there. eslint exits nonzero
    # only on ERRORS (warnings pass), so this is the errors-stay-zero contract.
    echo "[hub-precommit] eslint zero-error gate (src/)..."
    if ! npx --no-install eslint src; then
        echo ""
        echo "BLOCKED: eslint errors in src/ (baseline is ZERO since 2026-07-16)."
        echo "Fix the error or add a disable-with-reason comment; do not let the"
        echo "count regrow -- 440 problems were burned down to 0 in one day."
        exit 1
    fi
fi

exit 0
